<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Fastmark.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fastmark"
    Title="fastmark">


  <!-- Three panes: files (left, resizable) | content (*) | outline (right, resizable).
       Splitters are the thin local:Splitter columns; collapse via headers or toolbar. -->
  <Grid x:Name="Root" Background="{ThemeResource LayerFillColorDefaultBrush}">
  <Grid.Resources>
    <DataTemplate x:Key="OutlineTemplate">
      <TextBlock Text="{Binding Text}" Margin="{Binding Indent}" FontSize="{Binding Size}"
                 TextTrimming="CharacterEllipsis"/>
    </DataTemplate>
    <DataTemplate x:Key="HitTemplate">
      <StackPanel Spacing="2" Margin="0,2" Padding="8,6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE8A5;" FontSize="12"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
          <TextBlock Text="{Binding File}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Path}" Opacity="0.5" FontSize="11"
                     TextTrimming="CharacterEllipsis" MaxWidth="440"/>
        </StackPanel>
        <TextBlock Text="{Binding Snippet}" Opacity="0.75" FontSize="12"
                   TextTrimming="CharacterEllipsis" Margin="20,0,0,0"/>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="PanelHeaderText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
    <Style x:Key="PanelHeaderButton" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Grid.Resources>

    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="LeftColumn" Width="280" MinWidth="0"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition x:Name="RightColumn" Width="280" MinWidth="0"/>
    </Grid.ColumnDefinitions>

    <!-- ===================== LEFT: file browser ===================== -->
    <Grid x:Name="LeftPanel" Grid.Column="0" Margin="8,8,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="FILES" Style="{StaticResource PanelHeaderText}"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1" Style="{StaticResource PanelHeaderButton}"
                Click="OnCollapseLeft" ToolTipService.ToolTip="Collapse files panel">
          <FontIcon Glyph="&#xE76B;" FontSize="12"/>
        </Button>
      </Grid>
      <Button Grid.Row="1" x:Name="PickFolderButton" Click="OnPickFolder"
              Margin="0,0,0,6" HorizontalAlignment="Stretch"
              ToolTipService.ToolTip="Choose a folder"
              Style="{StaticResource AccentButtonStyle}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE838;" FontSize="14"/>
          <TextBlock Text="Open folder"/>
        </StackPanel>
      </Button>
      <TreeView Grid.Row="2" x:Name="FileTree" ItemInvoked="OnTreeInvoke"/>
    </Grid>

    <local:Splitter Grid.Column="1" x:Name="LeftSplitter"/>

    <!-- ===================== CENTER: content ===================== -->
    <Grid Grid.Column="2" Margin="4,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <CommandBar Grid.Row="0" HorizontalAlignment="Stretch" DefaultLabelPosition="Right">
        <CommandBar.Content>
          <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search every file in the folder (Enter)"
                          QueryIcon="Find" Width="420" Margin="0,4,12,4"
                          QuerySubmitted="OnSearchSubmit"/>
        </CommandBar.Content>
        <AppBarToggleButton x:Name="FilesToggle" Label="Files" Click="OnToggleLeft" IsChecked="True">
          <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
        </AppBarToggleButton>
        <AppBarToggleButton x:Name="OutlineToggle" Label="Outline" Click="OnToggleRight" IsChecked="True">
          <FontIcon Glyph="&#xE8FD;" FontSize="16"/>
        </AppBarToggleButton>
        <AppBarButton Label="File" Icon="OpenFile" Click="OnOpenFile"
                      ToolTipService.ToolTip="Open a Markdown file"/>
        <AppBarButton Label="Theme" Click="OnToggleTheme"
                      ToolTipService.ToolTip="Toggle light/dark">
          <FontIcon Glyph="&#xE708;"/>
        </AppBarButton>
      </CommandBar>

      <ListView Grid.Row="1" x:Name="Reader" SelectionMode="None"
                ContainerContentChanging="OnBlockRealized"
                Padding="24,8,32,24">
        <ListView.ItemTemplate>
          <DataTemplate>
            <ContentPresenter/>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <ListView Grid.Row="1" x:Name="Results" Visibility="Collapsed"
                IsItemClickEnabled="True" ItemClick="OnResultClick" Padding="16"
                ItemTemplate="{StaticResource HitTemplate}"
                SelectionMode="None"/>

      <StackPanel Grid.Row="1" x:Name="EmptyState" VerticalAlignment="Center"
                  HorizontalAlignment="Center" Spacing="12">
        <FontIcon Glyph="&#xE8B7;" FontSize="44"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        <TextBlock Text="Open a folder of Markdown, or pick a file" HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
    </Grid>

    <local:Splitter Grid.Column="3" x:Name="RightSplitter"/>

    <!-- ===================== RIGHT: outline ===================== -->
    <Grid x:Name="RightPanel" Grid.Column="4" Margin="0,8,8,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource PanelHeaderButton}"
                Click="OnCollapseRight" ToolTipService.ToolTip="Collapse outline panel">
          <FontIcon Glyph="&#xE76C;" FontSize="12"/>
        </Button>
        <TextBlock Grid.Column="1" Text="OUTLINE" Style="{StaticResource PanelHeaderText}"
                   Margin="10,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      <ListView Grid.Row="1" x:Name="OutlineList" SelectionMode="Single"
                IsItemClickEnabled="True" ItemClick="OnOutlineClick"
                ItemTemplate="{StaticResource OutlineTemplate}"/>
    </Grid>
  </Grid>
</Window>
